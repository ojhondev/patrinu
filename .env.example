# Banco — Neon Postgres (provisionado via `npx vercel@latest install neon --claim`)
# Rodar `npx vercel@latest env pull .env.local` para puxar os valores reais.
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# Sessão (auth própria por cookie assinado) — gerar com: openssl rand -hex 32
SESSION_SECRET=""

# Provedor de IA para extração/classificação de editais (Fase 1)
ANTHROPIC_API_KEY=""
